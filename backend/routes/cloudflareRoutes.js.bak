/**
 * Purge cache for a zone
 * POST /api/cloudflare/zones/:zoneId/purge_cache
 */
router.post('/zones/:zoneId/purge_cache', protect, async (req, res) => {
  try {
    const userId = req.user._id;
    const { zoneId } = req.params;
    
    // Get credentials for this user
    const credentials = await CloudflareCredentials.findOne({ userId });
    
    if (!credentials) {
      return res.status(404).json({
        success: false,
        message: 'No Cloudflare credentials found'
      });
    }
    
    // Purge cache
    const result = await cloudflareService.purgeCache(credentials.apiToken, zoneId);
    
    res.json(result);
  } catch (error) {
    console.error('Error purging cache:', error);
    res.status(500).json({
      success: false,
      message: 'Error purging cache',
      error: error.message
    });
  }
});

module.exports = router; 