const express = require('express');
const cors = require('cors');
const dotenv = require('dotenv');
const mongoose = require('mongoose');
const session = require('express-session');
const path = require('path');
const fs = require('fs');
const AWS = require('aws-sdk');
const morgan = require('morgan');

// Routes import
const awsCredentialsRoutes = require('./routes/awsCredentialsRoutes');
const authRoutes = require('./routes/authRoutes');
const subdomainRoutes = require('./routes/subdomainRoutes');
const serverDetectionRoutes = require('./routes/serverDetectionRoutes');
const certificateRoutes = require('./routes/certificateRoutes');
const traefikCertificateRoutes = require('./routes/traefikCertificateRoutes');
const certificateLifecycleRoutes = require('./routes/certificateLifecycleRoutes');
const awsIntegrationRoutes = require('./routes/awsIntegrationRoutes');
const healthRoutes = require('./routes/healthRoutes');
const metricsRoutes = require('./routes/metricsRoutes');

// Middleware import
const { verifyAwsCredentials } = require('./middleware/awsCredentialsMiddleware');

// Services import
const scheduledTasks = require('./services/scheduledTasks');
const healthMonitorService = require('./services/healthMonitorService');
const cloudflareService = require('./services/cloudflareService');

// Load env variables
dotenv.config();

// Configure AWS globally at startup if environment variables exist
if (process.env.AWS_ACCESS_KEY_ID && process.env.AWS_SECRET_ACCESS_KEY) {
  console.log('Configuring AWS with environment variables globally');
  AWS.config.update({
    accessKeyId: process.env.AWS_ACCESS_KEY_ID, 
    secretAccessKey: process.env.AWS_SECRET_ACCESS_KEY,
    region: process.env.AWS_REGION || 'us-east-1'
  });
}

// Verify AWS credentials on startup
verifyAwsCredentials().then(verified => {
  if (verified) {
    console.log('AWS environment variables are set up correctly. Users will not be prompted for credentials.');
  } else {
    console.log('Please configure AWS credentials in backend.env file to avoid credential prompts.');
  }
});

// Check if AWS credentials are configured
if (process.env.AWS_ACCESS_KEY_ID && process.env.AWS_SECRET_ACCESS_KEY && process.env.AWS_REGION) {
  console.log('AWS environment variables are set up correctly. Users will not be prompted for credentials.');
} else {
  console.log('AWS environment variables are missing. Users will need to enter credentials.');
}

// Check if Cloudflare API token is configured
if (process.env.CLOUDFLARE_API_TOKEN) {
  console.log('Cloudflare API token is set up correctly. Auto-configuring Cloudflare integration.');
  
  // Import models and services
  const User = require('./models/User');
  const CloudflareCredentials = require('./models/CloudflareCredentials');
  
  // Set up Cloudflare credentials for admin user
  const setupCloudflareCredentials = async () => {
    try {
      // Find the first admin user
      const adminUser = await User.findOne({ role: 'admin' });
      
      if (!adminUser) {
        console.log('No admin user found. Cloudflare credentials will be set up when an admin user is created.');
        return;
      }
      
      // Verify the API token
      const verification = await cloudflareService.verifyCredentials(process.env.CLOUDFLARE_API_TOKEN);
      
      if (!verification.valid) {
        console.error('Invalid Cloudflare API token:', verification.message);
        return;
      }
      
      // Check if credentials already exist for this user
      let credentials = await CloudflareCredentials.findOne({ userId: adminUser._id });
      
      if (credentials) {
        // Update existing credentials
        credentials.apiToken = process.env.CLOUDFLARE_API_TOKEN;
        await credentials.save();
        console.log('Cloudflare credentials updated for admin user.');
      } else {
        // Create new credentials
        credentials = new CloudflareCredentials({
          userId: adminUser._id,
          apiToken: process.env.CLOUDFLARE_API_TOKEN
        });
        await credentials.save();
        console.log('Cloudflare credentials created for admin user.');
      }
    } catch (error) {
      console.error('Error setting up Cloudflare credentials:', error);
    }
  };
  
  // Call the setup function after MongoDB connection is established
  mongoose.connection.once('open', () => {
    setupCloudflareCredentials();
  });
} else {
  console.log('Cloudflare API token is not set. Users will need to enter Cloudflare credentials through the UI.');
}

const app = express();

// Set up morgan for logging HTTP requests
app.use(morgan('dev'));

// Set up CORS with more permissive configuration
app.use(cors({
  origin: ['http://localhost:3000', 'http://localhost:5000', 'http://localhost:8081', 'http://localhost', '*'],
  credentials: true,
  methods: ['GET', 'POST', 'PUT', 'DELETE', 'OPTIONS'],
  allowedHeaders: ['Content-Type', 'Authorization', 'Origin', 'Accept']
}));

// Add logging for requests
app.use((req, res, next) => {
  console.log(`${req.method} ${req.originalUrl}`);
  next();
});

// Enable body parsing
app.use(express.json());

// Set up session middleware
app.use(session({
  secret: process.env.SESSION_SECRET || 'certpilot-session-secret',
  resave: false,
  saveUninitialized: false,
  cookie: { secure: process.env.NODE_ENV === 'production', maxAge: 3600000, sameSite: 'lax' } // 1 hour
}));

// Serve ACME challenge files for Let's Encrypt with logging
app.use('/.well-known/acme-challenge', (req, res, next) => {
  const challengeDir = path.join(process.cwd(), '.well-known', 'acme-challenge');
  const requestedFile = req.path;
  const filePath = path.join(challengeDir, requestedFile);
  
  console.log(`ACME challenge request for: ${req.path}`);
  console.log(`Looking for file: ${filePath}`);
  
  // List all files in the challenge directory
  try {
    const files = fs.readdirSync(challengeDir);
    console.log(`Files in challenge directory: ${files.join(', ')}`);
  } catch (err) {
    console.log(`Error reading challenge directory: ${err.message}`);
  }
  
  next();
});

app.use('/.well-known/acme-challenge', express.static(path.join(process.cwd(), '.well-known', 'acme-challenge')));

// Initialize Traefik dynamic directory
const traefikManager = require('./services/traefikManager');
traefikManager.ensureDynamicDir().catch(console.error);

// Routes
app.use('/api/auth', authRoutes);
app.use('/api/certificates', certificateRoutes);
app.use('/api/certificate-lifecycle', certificateLifecycleRoutes);
app.use('/api/aws-credentials', awsCredentialsRoutes);
app.use('/api/aws', awsIntegrationRoutes);
app.use('/api/subdomains', subdomainRoutes);
app.use('/api/server-detection', serverDetectionRoutes);
app.use('/api/health', healthRoutes);
app.use('/api/metrics', metricsRoutes);
app.use('/api/traefik-certificates', traefikCertificateRoutes);

// Add Cloudflare routes directly to app for simplicity
if (process.env.CLOUDFLARE_API_TOKEN) {
  // Get credentials endpoint
  app.get('/api/cloudflare/credentials', async (req, res) => {
    try {
      if (process.env.CLOUDFLARE_API_TOKEN) {
        // Verify the token works
        const verification = await cloudflareService.verifyCredentials(process.env.CLOUDFLARE_API_TOKEN);
        
        res.json({
          configured: true,
          email: 'api-token@cloudflare.com', // Dummy email since we're using token-based auth
          createdAt: new Date(),
          updatedAt: new Date()
        });
      } else {
        res.json({
          configured: false,
          message: 'No Cloudflare credentials found'
        });
      }
    } catch (error) {
      console.error('Error checking Cloudflare credentials status:', error);
      res.status(500).json({
        success: false,
        message: 'Error checking Cloudflare credentials status',
        error: error.message
      });
    }
  });

  // Get Cloudflare zones
  app.get('/api/cloudflare/zones', async (req, res) => {
    try {
      const result = await cloudflareService.listZones(process.env.CLOUDFLARE_API_TOKEN);
      res.json(result);
    } catch (error) {
      console.error('Error listing Cloudflare zones:', error);
      res.status(500).json({
        success: false,
        message: 'Error listing Cloudflare zones',
        error: error.message
      });
    }
  });

  // Other Cloudflare endpoints...
  // We'll add more as needed

  console.log('Cloudflare API endpoints added directly to app');
}

// Test endpoint
app.get('/test', (req, res) => {
  res.json({ message: 'Test endpoint works!' });
});

// Direct Cloudflare zones endpoint for testing
app.get('/api/cloudflare/zones', async (req, res) => {
  try {
    if (process.env.CLOUDFLARE_API_TOKEN) {
      const result = await cloudflareService.listZones(process.env.CLOUDFLARE_API_TOKEN);
      res.json(result);
    } else {
      res.status(400).json({
        success: false,
        message: 'Cloudflare API token not configured'
      });
    }
  } catch (error) {
    console.error('Error listing Cloudflare zones:', error);
    res.status(500).json({
      success: false,
      message: 'Error listing Cloudflare zones',
      error: error.message
    });
  }
});

// Home route for testing
app.get('/', (req, res) => {
  res.send('CertPilot API is running');
});

// Add error handling middleware AFTER routes
app.use((err, req, res, next) => {
  console.error('Error:', err);
  res.status(500).json({ message: err.message || 'Internal server error' });
});

// Connect to MongoDB
mongoose.connect(process.env.MONGODB_URI)
  .then(() => {
    console.log('MongoDB connected');
    
    // Do an initial health check
    healthMonitorService.checkAllServices().then(health => {
      console.log(`Initial health check - System status: ${health.overallStatus}`);
    }).catch(err => {
      console.error('Error in initial health check:', err);
    });
    
    // Initialize scheduled tasks after database connection is established
    // Always run scheduled tasks regardless of environment
    scheduledTasks.initScheduledTasks();
    console.log('Scheduled tasks initialized in all environments');
  })
  .catch(err => console.error('MongoDB connection error:', err));

// Start server
const PORT = process.env.PORT || 5000;
app.listen(PORT, () => {
  console.log(`Server running on port ${PORT}`);
}); 